"немесе жасалады."

#: core/importer.py:60
#, python-format
msgid "Файл не похож на JSON: строка %(line)s, позиция %(col)s: %(msg)s"
msgstr "Файл JSON-ға ұқсамайды: %(line)s-жол, %(col)s-позиция: %(msg)s"

#: core/importer.py:63
msgid "В файле нет списка задач (ключ \"tasks\")."
msgstr "Файлда есептер тізімі жоқ (\"tasks\" кілті)."

#: core/importer.py:66
#, python-format
msgid "У задачи №%(n)s нет названия (\"title\")."
msgstr "№%(n)s есептің атауы жоқ (\"title\")."

#: core/importer.py:70
#, python-format
msgid "Задача «%(title)s»: kind должен быть \"io\" или \"manual\"."
msgstr "«%(title)s» есебі: kind \"io\" немесе \"manual\" болуы керек."

#: core/importer.py:73
#, python-format
msgid "Задача «%(title)s»: tests должен быть списком."
msgstr "«%(title)s» есебі: tests тізім болуы керек."

#: core/importer.py:75
#, python-format
msgid "Задача «%(title)s»: для автопроверки нужны тесты."
msgstr "«%(title)s» есебі: автотексеру үшін тесттер қажет."

#: core/importer.py:78
#, python-format
msgid "Задача «%(title)s», тест %(n)s: нужен ключ \"output\"."
msgstr "«%(title)s» есебі, %(n)s-тест: \"output\" кілті қажет."

#: core/importer.py:94
#, python-format
msgid ""
"«%(title)s», тест %(n)s: эталон завершился с ошибкой (%(status)s). %(err)s"
msgstr ""
"«%(title)s», %(n)s-тест: эталон қатемен аяқталды (%(status)s). %(err)s"

#: core/importer.py:97
#, python-format
msgid ""
"«%(title)s», тест %(n)s: эталон вывел «%(got)s», в тесте «%(expected)s»."
msgstr ""
"«%(title)s», %(n)s-тест: эталон «%(got)s» шығарды, тестте «%(expected)s»."

#: core/judge/queue.py:76
#, python-format
msgid "Строка %(n)s"
msgstr "%(n)s-жол"

#: core/judge/queue.py:104
